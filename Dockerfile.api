# =============================================================================
# Farahna Platform — Production API Dockerfile (Express + Prisma + TypeScript)
# =============================================================================

# --- 1. Builder Stage ---
FROM node:20-alpine AS builder

WORKDIR /app
RUN apk add --no-cache libc6-compat openssl

# Copy root & workspaces manifests
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/api/package*.json ./apps/api/

# Install all dependencies (including dev for building)
RUN npm ci

# Copy and build shared library
COPY packages/shared ./packages/shared
RUN npm run build:shared

# Copy API codebase and generate Prisma Client
COPY apps/api ./apps/api
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

# Compile API to JavaScript
RUN npm run build:api

# --- 2. Production Runner Stage ---
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000
RUN apk add --no-cache openssl

# Prepare persistent local media storage directory
RUN mkdir -p /app/storage && chown -R node:node /app

# Copy production artifacts
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

USER node

EXPOSE 5000

# Runs database migrations automatically on startup before booting API
CMD ["sh", "-c", "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma && node apps/api/dist/server.js"]
