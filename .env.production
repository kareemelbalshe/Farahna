# =============================================================================
# Farahna Platform — Production Environment Configuration (.env.production)
# =============================================================================

# --- 1. Docker Compose Project & Port Configuration ---
COMPOSE_PROJECT_NAME=farahna
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
APP_DOMAIN=localhost

# --- 2. Database Configuration (PostgreSQL 16) ---
POSTGRES_USER=farahna
POSTGRES_PASSWORD=farahna_production_secure_pass_2026
POSTGRES_DB=farahna_db
DATABASE_URL=postgresql://farahna:farahna_production_secure_pass_2026@postgres:5432/farahna_db?schema=public

# --- 3. Backend API Service ---
NODE_ENV=production
PORT=5000
JWT_SECRET=farahna_super_secret_jwt_key_2026_egypt_weddings_production_grade
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
STORAGE_PATH=/app/storage

# --- 4. Frontend Web Application (Next.js 14) ---
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SITE_NAME=فرحنا — Farahna
NEXT_PUBLIC_WHATSAPP_NUMBER=201012345678
NEXT_PUBLIC_SUPPORT_PHONE=+201012345678

# --- 5. Regional Settings & Defaults ---
DEFAULT_TIMEZONE=Africa/Cairo

# --- 6. Admin Account Credentials for Initial Seeding ---
SEED_ADMIN_EMAIL=admin@farahna.com
SEED_ADMIN_PASSWORD=Farahna@2026!
