# =============================================================================
# Farahna Platform — Git Ignore Configuration
# =============================================================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Testing & Coverage
coverage/
test-results/
playwright-report/
blob-report/

# 3. Build & Compilation Artifacts
dist/
**/dist/
.next/
out/
build/
*.tsbuildinfo
.vite/
.cache/

# 4. Environment Variables & Deployment Secrets (Whitelisted for Private Repository)
.env.*.backup
*.env.backup
!.env
!.env.production
!.env.example
!.env.production.example
!apps/api/.env
!apps/web/.env.local

# 5. Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 6. Prisma Generated Database Files
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/*.db

# 7. Local Media Storage & Database Backups
/storage/
apps/api/storage/*
!apps/api/storage/.gitkeep
backups/
backups/*.sql
backups/*.sql.gz

# Allow Prisma migration SQL files and services
!apps/api/prisma/migrations/**/*.sql
!apps/api/src/services/**

# 8. SSL Keys & Certbot Certificates (Secrets)
infra/certbot/conf/*
!infra/certbot/conf/.gitkeep
infra/certbot/www/*
!infra/certbot/www/.gitkeep

# 9. Temporary Scratch Scripts
scratch*.js
scratch*.ts
scratch*.json
scratch/

# 10. IDEs & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db
.env
