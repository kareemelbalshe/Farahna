# =============================================================================
# Farahna Platform — Git Ignore Configuration
# =============================================================================

# 1. Dependencies
node_modules/
.pnp
.pnp.js

# 2. Testing & Coverage
coverage/
test-results/
playwright-report/
blob-report/

# 3. Build & Compilation Artifacts
dist/
**/dist/
.next/
out/
build/
*.tsbuildinfo
.vite/
.cache/

# 4. Environment Variables & Secrets (Never commit production credentials)
.env
.env.*
!.env.example
!.env.production.example
!.env.*.example
*.env
*.env.backup

# 5. Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 6. Prisma Generated Database Files
prisma/*.sqlite
prisma/*.sqlite-journal
prisma/*.db

# 7. Local Media Storage & Database Backups
storage/
**/storage/*
!**/storage/.gitkeep
backups/
*.sql
*.sql.gz

# 8. SSL Keys & Certbot Certificates (Secrets)
infra/certbot/conf/*
!infra/certbot/conf/.gitkeep
infra/certbot/www/*
!infra/certbot/www/.gitkeep

# 9. Temporary Scratch Scripts
scratch*.js
scratch*.ts
scratch*.json
scratch/

# 10. IDEs & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*.DS_Store
Thumbs.db
