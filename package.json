{
  "name": "farahna-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Farahna (فرحنا) - Premium Egyptian Digital Wedding Invitation SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@farahna/api",
    "dev:web": "npm run dev --workspace=@farahna/web",
    "dev": "npm run dev --workspace=@farahna/web",
    "build:shared": "npm run build --workspace=@farahna/shared",
    "build:api": "npm run build --workspace=@farahna/api",
    "build:web": "npm run build --workspace=@farahna/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "db:migrate": "npm run db:migrate --workspace=@farahna/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@farahna/api",
    "db:generate": "npm run db:generate --workspace=@farahna/api",
    "db:seed": "npm run db:seed --workspace=@farahna/api",
    "db:studio": "npm run db:studio --workspace=@farahna/api"
  },
  "keywords": [
    "wedding",
    "invitation",
    "saas",
    "egypt",
    "farahna",
    "instapay"
  ],
  "author": "Farahna Team",
  "license": "UNLICENSED"
}
