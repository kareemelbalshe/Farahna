# =============================================================================
# Farahna Platform — فرحنا (Production & Development Environment Template)
# =============================================================================

# --- 1. Database Configuration (PostgreSQL 16+) ---
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/farahna_db?schema=public"

# --- 2. Backend API Service ---
PORT=5000
NODE_ENV=production

# Security: In production, generate a secure random 64-character string (openssl rand -base64 48)
JWT_SECRET="replace_with_a_very_long_secure_random_production_secret_min_32_chars"
JWT_EXPIRES_IN="7d"

# Security: Comma-separated list of allowed frontend origins (NO '*' in production)
CORS_ORIGIN="https://farahna.com,https://admin.farahna.com"

# --- 3. Local Media Storage (Zero Cloudinary - 100% Local Persistent Disk) ---
STORAGE_PATH="/app/storage"
MAX_FILE_SIZE=10485760

# --- 4. Frontend Web Application (Next.js) ---
NEXT_PUBLIC_API_URL="https://api.farahna.com/api"
NEXT_PUBLIC_APP_URL="https://farahna.com"
NEXT_PUBLIC_SITE_NAME="فرحنا — Farahna"
NEXT_PUBLIC_WHATSAPP_NUMBER="201019262075"
NEXT_PUBLIC_SUPPORT_PHONE="+201019262075"

# --- 5. Egyptian Wedding Regional Settings ---
DEFAULT_TIMEZONE="Africa/Cairo"
